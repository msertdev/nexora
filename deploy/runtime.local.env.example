# Use with a unique Compose project name; these ports bind only to loopback.
APP_DOMAIN=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
COMPOSE_PROJECT_NAME=nexora-local-test
NEXORA_IMAGE_TAG=local

POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-new-local-only-password
POSTGRES_DB=nexora
# Replace URL_PASSWORD with the percent-encoded value of POSTGRES_PASSWORD.
DATABASE_URL=postgresql://nexora:URL_PASSWORD@db:5432/nexora?schema=public

PUBLIC_APP_URL=http://localhost:8080
# Local development defaults to public registration.
REGISTRATION_MODE=public
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexora.test
MAILPIT_SMTP_PORT=1026
MAILPIT_WEB_PORT=8026
