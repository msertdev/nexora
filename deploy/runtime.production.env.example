# Replace every placeholder. Protect the real file (chmod 600) and back it up
# separately from the database. Never commit deploy/runtime.env.
APP_DOMAIN=app.example.org
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
COMPOSE_PROJECT_NAME=nexora-prod
NEXORA_IMAGE_TAG=2026.10.21

POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=nexora
# URL-encode reserved characters in the password before placing it here.
DATABASE_URL=postgresql://nexora:URL_ENCODED_PASSWORD@db:5432/nexora?schema=public

PUBLIC_APP_URL=https://app.example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.org
