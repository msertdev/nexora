# Use the same local password as the root .env file for Docker Compose.
DATABASE_URL=postgresql://nexora:replace-with-a-local-password@127.0.0.1:5433/nexora?schema=public
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# NestJS running directly on Windows/macOS/Linux host:
SMTP_HOST=127.0.0.1
# If the API itself runs inside Docker Compose, use SMTP_HOST=mailpit instead.
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@nexora.local
# Mailpit has no authentication in this localhost-only development setup.
# Leave SMTP_USER and SMTP_PASSWORD unset unless your SMTP server requires both.
